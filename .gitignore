
# ------------------------------
# Keil MDK 工程专用忽略规则
# ------------------------------

# --- 工程文件与配置 ---
*.uvoptx
*.uvguix.*
*.bak
*.crf
*.d

# --- 编译输出文件 ---
*.o
*.obj
*.axf
*.hex
*.bin
*.map
*.lst

# --- 构建目录 ---
# 忽略 MDK-ARM 目录下的所有内容
/MDK-ARM/*

# 反向排除：保留 .uvprojx 和 .s 文件
!/MDK-ARM/*.uvprojx
!/MDK-ARM/*.s

Objects/
Listings/

# --- 调试与临时文件 ---
*.ini
*.log
*.dbg
*.cdb
*.tracespec

# --- IDE 自动生成文件 ---
*.uvmpw
*.dep
*.plg
*.jlink

# --- 其他临时文件 ---
*.~*
*.tmp
build/

# ------------------------------
# 通用忽略规则（补充）
# ------------------------------
*.user
.vscode/
.idea/
.DS_Store

